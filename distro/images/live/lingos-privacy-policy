#!/bin/bash
# 应用隐私等级到系统（开机执行）：sysctl / nftables / DNS / MAC 随机化
set -u
POLICY=/etc/lingos/security-policy.json
LEVEL=$(python3 -c 'import json;print(json.load(open("'"$POLICY"'")).get("privacy_level","L1"))' 2>/dev/null || true)
case "$LEVEL" in L0|L1|L2|L3|L4) ;; *) LEVEL=L1 ;; esac
mkdir -p /var/log/lingos /etc/lingos /etc/nftables.d /etc/sysctl.d /etc/NetworkManager/conf.d /etc/systemd/resolved.conf.d 2>/dev/null || true
/usr/local/bin/lingos-audit log privacy-apply "level=$LEVEL" >/dev/null 2>&1 || true

cat > /etc/sysctl.d/99-lingos-privacy.conf <<EOF
kernel.kptr_restrict=2
kernel.dmesg_restrict=1
kernel.yama.ptrace_scope=2
kernel.unprivileged_bpf_disabled=1
kernel.kexec_load_disabled=1
net.ipv6.conf.all.use_tempaddr=2
net.ipv6.conf.default.use_tempaddr=2
EOF
sysctl -q -p /etc/sysctl.d/99-lingos-privacy.conf 2>/dev/null || true

# DNS over TLS（systemd-resolved）
if [ "$LEVEL" != "L0" ]; then
  cat > /etc/systemd/resolved.conf.d/99-lingos.conf <<EOF
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 8.8.8.8#dns.google
DNSOverTLS=yes
DNSSEC=allow-downgrade
EOF
else
  rm -f /etc/systemd/resolved.conf.d/99-lingos.conf 2>/dev/null || true
fi

# MAC 随机化
cat > /etc/NetworkManager/conf.d/99-lingos-privacy.conf <<EOF
[device]
wifi.scan-rand-mac-address=yes
[connection]
wifi.cloned-mac-address=stable
ethernet.cloned-mac-address=stable
EOF

# nftables：默认拒绝入站；L2+ 更严格出站
if command -v nft >/dev/null 2>&1; then
  case "$LEVEL" in
    L0|L1)
      RULES='table inet lingos {
  chain input { type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
    udp dport 68 accept
  }
  chain forward { type filter hook forward priority 0; policy drop; }
}'
      ;;
    *)
      RULES='table inet lingos {
  chain output { type filter hook output priority 0; policy drop;
    oif lo accept
    ct state established,related accept
    udp dport 53 accept
    tcp dport 443 accept
  }
  chain input { type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
  }
  chain forward { type filter hook forward priority 0; policy drop; }
}'
      ;;
  esac
  printf '%s\n' "$RULES" > /etc/nftables.d/lingos.nft
  nft flush ruleset 2>/dev/null || true
  nft -f /etc/nftables.d/lingos.nft 2>/dev/null || true
fi

echo "$LEVEL" > /run/lingos-privacy-level 2>/dev/null || true
echo "applied level=$LEVEL"
