#!/bin/sh
# LING OS initramfs 早期标记（init-premount，不阻塞启动）
# 写入 kmsg 与串口，便于 CI/真机确认内核与 initramfs 已启动；
# 同时预加载 live-boot 所需的文件系统/存储模块（其 is_supported_fs 检查 /proc/filesystems）。
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

for m in isofs squashfs overlay loop sr_mod sd_mod usb-storage uas virtio_blk virtio_pci; do
    modprobe -q "$m" 2>/dev/null || true
done

msg="LINGOS-INITRAMFS-START kernel=$(uname -r) modules=$(cat /proc/filesystems 2>/dev/null | tr '\n' ',' | head -c 200)"
printf '<6>%s\n' "LINGOS-INITRAMFS-START kernel=$(uname -r)" > /dev/kmsg 2>/dev/null || true
for c in /dev/ttyAMA0 /dev/ttyS0; do
    [ -e "$c" ] && printf 'LINGOS-INITRAMFS-START kernel=%s\n' "$(uname -r)" > "$c" 2>/dev/null || true
done
if [ -d /run/live ]; then
    printf '<6>LINGOS-INITRAMFS-LIVE-DIR-OK\n' > /dev/kmsg 2>/dev/null || true
fi
exit 0
