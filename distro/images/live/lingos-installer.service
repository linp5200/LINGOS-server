[Unit]
Description=LING OS ISO Boot Mode (installer / live / diagnostics)
ConditionPathExists=/etc/lingos-live
After=live-config.service systemd-user-sessions.service local-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/lingos-boot-mode
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=no
Restart=no

[Install]
WantedBy=multi-user.target