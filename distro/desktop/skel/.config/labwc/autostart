# LING OS Wayland 桌面自启（labwc）
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
export WLR_NO_HARDWARE_CURSORS=1
export XDG_CURRENT_DESKTOP=LINGOS
command -v swaybg >/dev/null 2>&1 && swaybg -i /usr/share/lingos/wallpapers/lingos-default.png -m fill &
command -v waybar >/dev/null 2>&1 && waybar &
command -v mako >/dev/null 2>&1 && mako &
command -v pcmanfm >/dev/null 2>&1 && pcmanfm --desktop &
